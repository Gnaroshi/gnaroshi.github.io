---
import BaseLayout from "../layouts/BaseLayout.astro";
import ReadingNextAction from "../components/papers/ReadingNextAction.astro";
import ImplementationCard from "../components/implementations/ImplementationCard.astro";
import type { Locale } from "../i18n/types";
import { translate } from "../i18n/utils";
import { getPublishedImplementationAttempts } from "../utils/implementations";
import { getIslandMessages } from "../i18n/islands";
import "../styles/application.css";
import "../styles/insights.css";
import "../styles/papers.css";
interface Props { locale: Locale }
const { locale } = Astro.props;
const attempts = await getPublishedImplementationAttempts(locale);
const messages = getIslandMessages(locale).implementation;
---
<BaseLayout locale={locale} title={translate(locale, "paperLab.implementations")} description={translate(locale, "implementations.subtitle")} width="wide" mode="application">
  <header class="page-header"><h1>{translate(locale, "implementations.title")}</h1>{attempts.length > 0 && <p class="lede">{translate(locale, "implementations.subtitle")}</p>}</header>
  {attempts.length ? <div class="implementation-grid">{attempts.map((attempt) => <ImplementationCard attempt={attempt} locale={locale} messages={messages} />)}</div> : <section class="app-empty-state" aria-labelledby="implementations-empty"><h2 id="implementations-empty">{translate(locale, "implementations.empty")}</h2><ReadingNextAction locale={locale} /></section>}
</BaseLayout>

---
import { ArrowLeft, ArrowRight, List, GalleryHorizontal } from "lucide-react";
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHeader from "../components/layout/PageHeader.astro";
import PageShell from "../components/layout/PageShell.astro";
import ResponsiveImage from "../components/media/ResponsiveImage.astro";
import MediaZoomDialog from "../components/common/MediaZoomDialog.astro";
import ResearchLens from "../components/research/ResearchLens.astro";
import SpatialScene from "../components/scene/SpatialScene.astro";
import { getResearchMedia } from "../data/approvedMedia";
import { getLocalizedData } from "../data/locales";
import { getPublicCapabilities } from "../utils/publicCapabilities";
import type { Locale } from "../i18n/types";
import { getLocalePath, translate } from "../i18n/utils";
interface Props { locale: Locale }
const { locale } = Astro.props;
const data = getLocalizedData(locale);
const capabilities = getPublicCapabilities();
const labels = locale === "ko"
  ? { navigation:"연구 질문", previous:"이전 질문", next:"다음 질문", all:"전체 질문", explore:"질문 탐색", images:"연구 질문 이미지", concept:"생성한 개념 장면", conceptDetail:"연구 질문을 설명하기 위한 장면이며 실험 결과가 아닙니다.", diagram:"기술 도식", diagramDetail:"이 연구 질문을 설명하기 위해 만든 도식입니다." }
  : { navigation:"Research questions", previous:"Previous question", next:"Next question", all:"All questions", explore:"Explore questions", images:"Research question images", concept:"Generated concept scene", conceptDetail:"An illustration of the research question, not experiment evidence.", diagram:"Technical diagram", diagramDetail:"An original explanatory diagram for this research question." };
---
<BaseLayout locale={locale} title={translate(locale,"nav.research")} description={translate(locale,"research.intro")} width="wide" pageProgress>
  <PageShell class="research-page">
    <div class="research-intro" data-scene-surface><SpatialScene variant="terrain" locale={locale} /><div data-scene-copy><PageHeader eyebrow={translate(locale,"research.eyebrow")} title={translate(locale,"research.title")} description={translate(locale,"research.intro")} /></div></div>
    <div class="research-explorer" data-research-explorer data-explorer-labels={JSON.stringify({all:labels.all,explore:labels.explore})}>
      <nav class="section-nav research-overview" aria-label={labels.navigation} data-in-page-navigation data-scroll-spy>
        <ol data-in-page-scroller>
          {data.researchAreas.map(area => {
            const media = getResearchMedia(area.id,locale);
            return <li><a href={getLocalePath(locale,`/research/#${area.slug}`)} data-in-page-link>
              <img src={`/media/approved/${media.id}-${media.widths[0]}.webp`} width="80" height="60" alt="" loading="lazy" decoding="async" />
              <span>{area.shortTitle}</span>
            </a></li>;
          })}
        </ol>
      </nav>
      <div class="research-heading" hidden data-research-heading></div>
      <div class="research-spread">
        <div class="research-themes" data-research-themes>
          {data.researchAreas.map((area,index) => {
            const media = getResearchMedia(area.id,locale);
            const caption = index === 0 ? labels.concept : labels.diagram;
            const detail = index === 0 ? labels.conceptDetail : labels.diagramDetail;
            const related = area.related.filter(link => !link.href.includes("/papers/") || capabilities.hasPapers);
            return <article class="research-theme" data-research-topic data-topic-id={area.slug} aria-labelledby={`${area.slug}-title`}>
              <header id={area.slug} class="research-theme__header" data-research-topic-heading data-in-page-section tabindex="-1">
                  <h2 id={`${area.slug}-title`}>{area.question}</h2>
              </header>
              <div class="research-theme__copy">
                <p>{area.motivation}</p>
                <ResearchLens id={area.slug} hypothesis={area.hypothesis} uncertainty={area.uncertainty} locale={locale} />
                <div class="link-row">{related.map(link => <a href={link.href}>{link.label}</a>)}</div>
              </div>
              <figure class="research-theme__media" data-research-figure aria-labelledby={`${area.slug}-title`}>
                <ResponsiveImage asset={media} locale={locale} sizes="(min-width:1024px) 50vw, 100vw" fit="contain" />
                <figcaption><strong>{caption}</strong><span>{detail}</span></figcaption>
                <MediaZoomDialog asset={media} locale={locale} title={area.question} caption={`${caption}. ${detail}`} mediaKind={index === 0 ? "concept" : "diagram"} />
              </figure>
            </article>;
          })}
        </div>
        <div class="research-gallery" hidden data-research-gallery>
          <div class="research-gallery__viewport" tabindex="0" role="region" aria-label={labels.images} aria-roledescription={locale === "ko" ? "이미지 갤러리" : "carousel"} data-research-viewport>
            <div class="research-gallery__track" data-research-track></div>
          </div>
          <div class="research-gallery__controls">
            <button type="button" data-research-previous title={labels.previous} aria-label={labels.previous}><ArrowLeft size={20} aria-hidden="true" /></button>
            <button type="button" data-research-next title={labels.next} aria-label={labels.next}><ArrowRight size={20} aria-hidden="true" /></button>
          </div>
        </div>
      </div>
      <button class="research-view-control" hidden type="button" data-research-mode="all">
        <span data-research-list-icon><List size={18} aria-hidden="true" /></span><span data-research-gallery-icon hidden><GalleryHorizontal size={18} aria-hidden="true" /></span><span data-research-view-label>{labels.all}</span>
      </button>
    </div>
  </PageShell>
</BaseLayout>
<script>
  import { mountResearchExplorer } from "../utils/researchExplorer";
  for(const root of document.querySelectorAll<HTMLElement>("[data-research-explorer]"))mountResearchExplorer(root);
</script>
<style>
  .research-intro { position:relative; min-height:400px; display:grid; align-items:center; isolation:isolate; }
  .research-intro > [data-scene-copy] { position:relative; z-index:1; max-width:55%; }
  .research-intro:has([data-renderer="fallback"]) { min-height:0; }
  .research-intro:has([data-renderer="fallback"]) > [data-scene-copy] { max-width:none; }
  @media(scripting:none) { .research-intro { min-height:0; } .research-intro > [data-scene-copy] { max-width:none; } }
  .research-explorer { display:grid; gap:var(--space-5); min-width:0; }
  .research-overview { position:sticky; top:var(--header-height); z-index:12; background:var(--color-bg); padding-block:var(--space-2); }
  .research-overview ol { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:var(--space-3); margin:0; padding:0; list-style:none; }
  .research-overview li { min-width:0; }
  .research-overview a { display:grid; grid-template-columns:80px minmax(0,1fr); align-items:center; gap:var(--space-3); min-height:76px; padding:var(--space-2); text-decoration:none; color:var(--color-text-secondary); border-bottom:3px solid transparent; font-size:var(--text-sm); font-weight:700; }
  .research-overview img { width:80px; height:60px; object-fit:contain; }
  .research-overview a[aria-current="location"] { border-color:var(--color-accent); color:var(--color-text); background:var(--color-accent-soft); }
  .research-spread,.research-themes,.research-heading { min-width:0; }
  .research-heading[hidden],.research-gallery[hidden],[data-research-topic][hidden],[data-research-topic-heading][hidden] { display:none; }
  .research-theme { display:grid; gap:var(--space-5); padding-block:var(--space-5); }
  .research-theme__header { grid-column:1/-1; grid-row:1; }
  .research-theme__media { grid-row:2; }
  .research-theme__copy { grid-row:3; }
  .research-theme:first-child { padding-block-start:0; }
  .research-theme__copy { display:grid; gap:var(--space-5); align-content:start; }
  .research-theme__header { scroll-margin-top:calc(var(--header-height) + var(--section-nav-height) + var(--space-4)); }
  .research-theme__header:focus { outline:none; }
  .research-theme__header:focus-visible h2 { text-decoration:underline; text-decoration-color:var(--color-focus); text-underline-offset:5px; }
  .research-theme__header h2 { font-size:var(--text-xl); line-height:1.3; max-width:1000px; }
  .research-theme__copy > p { font-size:var(--editorial-body); line-height:1.7; color:var(--color-text-secondary); }
  .research-theme__media { display:grid; align-content:start; gap:var(--space-3); min-width:0; margin:0; }
  .research-theme__media :global(.responsive-media) { width:100%; aspect-ratio:4/3; }
  .research-theme__media figcaption { display:grid; gap:var(--space-1); color:var(--color-text-muted); font-size:var(--text-xs); line-height:1.5; }
  .research-theme__media figcaption strong { color:var(--color-text-secondary); }
  .research-theme__media :global(.media-zoom__actions) { padding:0; border:0; }
  .research-gallery { position:relative; min-width:0; align-self:start; }
  .research-gallery__viewport { overflow:hidden; cursor:grab; touch-action:pan-y pinch-zoom; scroll-margin-block:calc(var(--header-height) + var(--section-nav-height) + var(--space-3)); }
  .research-gallery__viewport:active { cursor:grabbing; }
  .research-gallery__track { display:flex; align-items:start; }
  .research-gallery__track > :global(figure) { flex:0 0 100%; min-width:0; }
  .research-gallery__track :global(img) { user-select:none; -webkit-user-drag:none; }
  .research-gallery__controls { display:flex; justify-content:flex-end; gap:var(--space-2); padding-top:var(--space-3); }
  .research-gallery__controls button { display:grid; width:44px; height:44px; place-items:center; border:0; border-bottom:2px solid var(--color-accent); background:var(--color-surface-muted); color:var(--color-text); cursor:pointer; }
  .research-gallery__controls button:disabled { opacity:.35; cursor:default; border-color:var(--color-border); }
  .research-view-control { display:flex; gap:var(--space-2); align-items:center; justify-self:start; min-height:44px; border:0; background:none; color:var(--color-accent); padding:var(--space-2) 0; font:inherit; font-size:var(--text-sm); cursor:pointer; }
  .research-view-control[hidden],.research-view-control :global([hidden]) { display:none; }
  [data-mode="focus"] .research-theme { padding:0; }
  .research-explorer [data-research-topic][hidden] { display:none; }
  [data-mode="focus"] .research-spread { display:grid; gap:var(--space-5); }
  [data-mode="focus"] .research-gallery { grid-row:1; grid-column:1; }
  [data-mode="focus"] .research-themes { grid-row:2; grid-column:1; }
  @media(scripting:enabled) { .research-explorer:not([data-enhanced]) [data-research-topic]:not(:first-child) { display:none; } .research-explorer:not([data-enhanced]) .research-theme__media { padding-bottom:56px; } }
  @media(min-width:1024px) { .research-theme { grid-template-columns:minmax(0,.9fr) minmax(0,1.1fr); gap:var(--space-5) var(--space-7); } .research-theme__copy { grid-row:2; grid-column:1; } .research-theme__media { grid-row:2; grid-column:2; } [data-mode="focus"] .research-theme { display:block; } [data-mode="focus"] .research-spread { grid-template-columns:minmax(0,.9fr) minmax(0,1.1fr); gap:var(--space-7); align-items:start; } [data-mode="focus"] .research-gallery { grid-row:1; grid-column:2; } [data-mode="focus"] .research-themes { grid-row:1; } }
  @media(max-width:767px) { .research-intro { min-height:520px; align-items:start; } .research-intro > [data-scene-copy] { max-width:none; } .research-overview a { grid-template-columns:1fr; align-content:start; gap:var(--space-2); padding:var(--space-2) var(--space-1); font-size:var(--text-xs); } .research-overview img { width:100%; height:auto; aspect-ratio:4/3; } .research-overview ol { gap:var(--space-2); } .research-theme__header h2 { font-size:var(--text-lg); } }
</style>

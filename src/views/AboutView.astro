---
import BaseLayout from "../layouts/BaseLayout.astro";
import ExternalLink from "../components/common/ExternalLink.astro";
import PageHeader from "../components/layout/PageHeader.astro";
import PageShell from "../components/layout/PageShell.astro";
import InteractiveIdentity from "../components/identity/InteractiveIdentity.astro";
import ToolConnections from "../components/about/ToolConnections.astro";
import { getLocalizedData } from "../data/locales";
import { profile } from "../data/profile";
import type { Locale } from "../i18n/types";
import { translate } from "../i18n/utils";
interface Props { locale: Locale }
const { locale } = Astro.props;
const data = getLocalizedData(locale);
const links = [{ label: "GitHub", href: profile.links.github }, profile.links.email ? { label: "Email", href: `mailto:${profile.links.email}` } : null, profile.links.scholar ? { label: "Google Scholar", href: profile.links.scholar } : null, profile.links.linkedin ? { label: "LinkedIn", href: profile.links.linkedin } : null, profile.links.cv ? { label: "CV", href: profile.links.cv } : null].filter(Boolean) as Array<{ label: string; href: string }>;
---

<BaseLayout locale={locale} title={translate(locale, "about.title")} description={data.profile.aboutIntroduction} width="wide">
  <PageShell class="about-page">
    <div class="about-introduction"><div class="about-introduction__copy"><PageHeader eyebrow={profile.displayName} title={translate(locale, "about.title")} description={data.profile.aboutIntroduction} /><div class="prose-stack">{data.profile.bio.map((paragraph) => <p>{paragraph}</p>)}</div></div><InteractiveIdentity locale={locale} /></div>
    <ToolConnections locale={locale} />
    <section class="section" aria-labelledby="about-values"><h2 id="about-values">{translate(locale, "about.values")}</h2><ul>{data.profile.researcherValues.map((value) => <li>{value}</li>)}</ul></section>
    {links.length > 0 && <section class="section" aria-labelledby="about-links"><h2 id="about-links">{translate(locale, "about.links")}</h2><div class="link-row">{links.map((link) => <ExternalLink href={link.href}>{link.label}</ExternalLink>)}</div></section>}
  </PageShell>
</BaseLayout>

<style>
  .about-introduction { position:relative; display:grid; gap:var(--space-5); align-items:start; isolation:isolate; }
  .about-introduction__copy { position:relative; z-index:1; display:grid; gap:var(--space-5); }
  .about-introduction :global(.interactive-identity) { position:relative; z-index:1; }
  .about-introduction :global(.page-header) { margin:0; }
  .about-page .prose-stack { max-width:720px; }
  .about-page .section > ul { display:grid; gap:var(--space-3); margin:0; padding-inline-start:1.2rem; color:var(--color-text-secondary); }
  @media (min-width:768px) { .about-introduction { grid-template-columns:minmax(0,1fr) minmax(240px,.6fr); gap:var(--space-7); } }
</style>

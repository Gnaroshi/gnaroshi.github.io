---
import RedirectPage from "../components/RedirectPage.astro";
import type { Locale } from "../i18n/types";
import { getLocalePath } from "../i18n/utils";
import { getPaperDiscoveryEntries } from "../utils/papers";
interface Props { locale: Locale }
const { locale } = Astro.props;
const hasPapers = (await getPaperDiscoveryEntries(locale)).length > 0;
const target = getLocalePath(locale, hasPapers ? "/papers/" : "/research/#human-ai-research-tools");
---
<RedirectPage target={target} />

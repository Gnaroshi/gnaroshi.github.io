---
import BaseLayout from "../layouts/BaseLayout.astro";
import ReadingNextAction from "../components/papers/ReadingNextAction.astro";
import QueueDashboard from "../components/queue/QueueDashboard";
import type { Locale } from "../i18n/types";
import { translate } from "../i18n/utils";
import { getPublishedQueueItems, getQueueTags, getQueueTopics, toQueueRecord } from "../utils/queue";
import { getIslandMessages } from "../i18n/islands";
import "../styles/application.css";
import "../styles/papers.css";
interface Props { locale: Locale }
const { locale } = Astro.props;
const items = await getPublishedQueueItems(locale);
const records = items.map(toQueueRecord);
const topics = getQueueTopics(items);
const tags = getQueueTags(items);
const messages = getIslandMessages(locale);
---
<BaseLayout locale={locale} title={translate(locale, "paperLab.readingQueue")} description={translate(locale, "queue.subtitle")} width="dashboard" mode="application">
  <div class="paper-dashboard">
    <header class="paper-hero"><div class="paper-hero__copy"><h1>{translate(locale, "queue.title")}</h1>{items.length > 0 && <p class="lede">{translate(locale, "queue.subtitle")}</p>}</div></header>
    {items.length ? <div id="queue-list"><QueueDashboard client:visible items={records} topics={topics} tags={tags} locale={locale} messages={messages.queue} /></div> : <section class="app-empty-state" aria-labelledby="queue-empty"><h2 id="queue-empty">{translate(locale, "queue.empty")}</h2><ReadingNextAction locale={locale} /></section>}
  </div>
</BaseLayout>

---
import { ZoomIn, ZoomOut, RotateCcw } from "lucide-react";
import type { Locale } from "../../i18n/types";
interface Props { locale:Locale; id:string }
const {locale,id}=Astro.props;
const labels=locale==="ko"?{name:"이미지 자세히 살펴보기",in:"확대",out:"축소",reset:"전체 이미지",help:"확대 후 드래그하거나 방향키로 살펴봅니다. 더하기와 빼기로 배율을 바꾸고 Escape로 전체 이미지를 봅니다."}:{name:"Inspect image",in:"Zoom in",out:"Zoom out",reset:"Show full image",help:"After zooming, drag or use the arrow keys to inspect the image. Plus and minus change zoom. Escape restores the full image."};
---
<div class="evidence-inspector" data-evidence-inspector>
  <div class="evidence-inspector__viewport" data-inspector-viewport role="group" aria-label={labels.name} aria-describedby={`${id}-help`} tabindex="-1"><slot /></div>
  <div class="evidence-inspector__controls" hidden data-inspector-controls>
    <button type="button" data-inspector-out aria-label={labels.out} title={labels.out}><ZoomOut size={18} aria-hidden="true"/></button>
    <output data-inspector-zoom aria-live="polite">100%</output>
    <button type="button" data-inspector-in aria-label={labels.in} title={labels.in}><ZoomIn size={18} aria-hidden="true"/></button>
    <button type="button" data-inspector-reset aria-label={labels.reset} title={labels.reset}><RotateCcw size={18} aria-hidden="true"/></button>
  </div>
  <span class="sr-only" id={`${id}-help`}>{labels.help}</span>
</div>
<script>
  import {mountEvidenceInspector} from "../../utils/evidenceInspector";
  for(const root of document.querySelectorAll<HTMLElement>("[data-evidence-inspector]"))mountEvidenceInspector(root);
</script>
<style>
  .evidence-inspector { display:grid; gap:var(--space-2); min-width:0; }
  .evidence-inspector__viewport { position:relative; overflow:hidden; aspect-ratio:4/3; touch-action:pan-y pinch-zoom; }
  .evidence-inspector__viewport :global(picture) { display:block; width:100%; height:100%; transform-origin:center; }
  .evidence-inspector__viewport :global(img) { width:100%; height:100%; object-fit:contain; user-select:none; -webkit-user-drag:none; }
  [data-zoomed="true"] .evidence-inspector__viewport { cursor:grab; touch-action:none; }
  [data-panning="true"] .evidence-inspector__viewport { cursor:grabbing; }
  .evidence-inspector__controls { display:flex; align-items:center; justify-content:flex-end; gap:var(--space-2); }
  .evidence-inspector__controls[hidden] { display:none; }
  button { display:grid; place-items:center; min-width:44px; min-height:44px; padding:0; background:var(--color-bg); color:var(--color-text); border:1px solid var(--color-border); cursor:pointer; }
  button:disabled { opacity:.4; cursor:default; }
  output { min-width:4em; text-align:center; font:var(--text-xs) var(--font-mono); }
  @media(prefers-reduced-motion:no-preference) { [data-evidence-inspector]:not([data-panning="true"]) :global(picture) { transition:transform 180ms ease-out; } }
</style>

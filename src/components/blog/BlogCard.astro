---
import Card from "../common/Card.astro";
import BlogMeta from "./BlogMeta.astro";
import TagList from "./TagList.astro";
import BlogLanguages from "./BlogLanguages.astro";
import type { BlogPost } from "../../utils/content";
import type { Locale } from "../../i18n/types";
import { getBlogPostHref, getBlogPostLanguages } from "../../utils/content";

interface Props {
  post: BlogPost;
  locale?: Locale;
  allPosts?: BlogPost[];
}

const { post, locale = post.data.locale, allPosts = [] } = Astro.props;
---

<Card title={post.data.title} href={getBlogPostHref(post)} description={post.data.description} contentLang={post.data.locale}>
  <div class="blog-card__metadata"><BlogMeta post={post} locale={locale} /><BlogLanguages languages={getBlogPostLanguages(allPosts, post)} selected={post.data.locale} title={post.data.title} locale={locale} /></div>
  <TagList tags={post.data.tags} locale={locale} />
</Card>

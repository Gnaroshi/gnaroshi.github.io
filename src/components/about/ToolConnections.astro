---
import { ArrowUpRight } from "lucide-react";
import { projectFacts } from "../../data/facts/projects";
import { techCatalog } from "../../data/facts/techCatalog";
import { getProjectStory } from "../../data/projectStories";
import { getLocalePath } from "../../i18n/utils";
import type { Locale } from "../../i18n/types";
interface Props { locale: Locale }
const { locale } = Astro.props;
const tools = ["python", "typescript", "swift", "react", "shell"] as const;
const labels = locale === "ko"
  ? { title:"도구에서 프로젝트로", tools:"기술 선택", projects:"연결된 프로젝트", all:"전체 프로젝트" }
  : { title:"From tools to projects", tools:"Choose a technology", projects:"Connected projects", all:"All projects" };
---
<section class="section tool-connections" data-tool-connections aria-labelledby="about-tools">
  <h2 id="about-tools">{labels.title}</h2>
  <div class="tool-connections__map" data-tool-map>
    <div class="tool-connections__tools" role="group" aria-label={labels.tools}>
      {tools.map((id) => <button type="button" data-tool-choice={id} aria-pressed="false" disabled>{techCatalog[id].label}<span aria-hidden="true">→</span></button>)}
    </div>
    <svg class="tool-connections__paths" aria-hidden="true" data-tool-paths></svg>
    <div class="tool-connections__results">
      <ul aria-label={labels.projects}>
        {projectFacts.map((project) => <li data-tool-project data-tools={project.techStack.join(" ")}>
          <a href={getLocalePath(locale,`/projects/${project.slug}/`)}><span>{getProjectStory(locale,project.id).title}</span><ArrowUpRight size={16} aria-hidden="true" /></a>
          <span class="tool-connections__match" data-tool-match></span>
        </li>)}
      </ul>
    </div>
  </div>
  <a class="text-link" href={getLocalePath(locale,"/projects/")}>{labels.all}</a>
</section>
<script>
  for (const root of document.querySelectorAll<HTMLElement>("[data-tool-connections]")) {
    const map = root.querySelector<HTMLElement>("[data-tool-map]")!;
    const svg = root.querySelector<SVGSVGElement>("[data-tool-paths]")!;
    const choices = [...root.querySelectorAll<HTMLButtonElement>("[data-tool-choice]")];
    const projects = [...root.querySelectorAll<HTMLElement>("[data-tool-project]")];
    let selected = choices[0]!;
    let frame = 0;
    const draw = () => {
      frame = 0;
      svg.replaceChildren();
      if (map.clientWidth < 600) return;
      const bounds = map.getBoundingClientRect();
      const source = selected.getBoundingClientRect();
      svg.setAttribute("viewBox",`0 0 ${bounds.width} ${bounds.height}`);
      const x = source.right - bounds.left + 8;
      const y = source.top - bounds.top + source.height / 2;
      for (const project of projects.filter(project => project.dataset.connected === "true")) {
        const target = project.getBoundingClientRect();
        const tx = target.left - bounds.left - 8;
        const ty = target.top - bounds.top + target.height / 2;
        const path = document.createElementNS("http://www.w3.org/2000/svg","path");
        path.setAttribute("d",`M ${x} ${y} H ${(x+tx)/2} V ${ty} H ${tx}`);
        svg.append(path);
      }
    };
    const schedule = () => { if (!frame) frame = requestAnimationFrame(draw); };
    const select = (button:HTMLButtonElement) => {
      selected = button;
      const tool = button.dataset.toolChoice!;
      choices.forEach(choice => choice.setAttribute("aria-pressed",String(choice === button)));
      projects.forEach(project => {
        const connected = project.dataset.tools!.split(" ").includes(tool);
        project.dataset.connected = String(connected);
        project.querySelector<HTMLElement>("[data-tool-match]")!.textContent = connected ? button.childNodes[0]!.textContent : "";
      });
      schedule();
    };
    choices.forEach((button,index) => {
      button.disabled = false;
      button.addEventListener("click",() => {
        select(button);
        button.scrollIntoView({block:"nearest",behavior:"instant"});
      });
      button.addEventListener("keydown",event => {
        const delta = ["ArrowRight","ArrowDown"].includes(event.key) ? 1 : ["ArrowLeft","ArrowUp"].includes(event.key) ? -1 : 0;
        if (!delta) return;
        event.preventDefault();
        const next = choices[(index + delta + choices.length) % choices.length]!;
        next.focus({preventScroll:true}); select(next);
        next.scrollIntoView({block:"nearest",behavior:"instant"});
      });
    });
    root.dataset.enhanced = "true";
    select(selected);
    const observer = new ResizeObserver(schedule); observer.observe(map);
    window.addEventListener("pagehide",() => {observer.disconnect();cancelAnimationFrame(frame);frame=0;});
    window.addEventListener("pageshow",event => {if(event.persisted){observer.observe(map);schedule();}});
  }
</script>
<style>
  .tool-connections { display:grid; gap:var(--space-4); }
  .tool-connections__map { position:relative; display:grid; gap:var(--space-4); }
  .tool-connections__tools { display:flex; flex-wrap:wrap; gap:var(--space-2); }
  button { display:flex; align-items:center; justify-content:space-between; gap:var(--space-3); min-height:44px; padding:var(--space-2) var(--space-3); border:1px solid var(--color-border); background:var(--color-surface); color:var(--color-text); font:inherit; font-size:var(--text-sm); cursor:pointer; scroll-margin-block:calc(var(--header-height) + var(--space-3)) var(--space-4); }
  button[aria-pressed="true"] { border-color:var(--color-accent); box-shadow:inset 3px 0 var(--color-identity-orange); background:var(--color-accent-soft); }
  button:disabled { cursor:default; }
  button span { color:var(--color-accent); }
  .tool-connections__paths { position:absolute; inset:0; width:100%; height:100%; pointer-events:none; }
  .tool-connections__paths :global(path) { fill:none; stroke:var(--color-identity-teal); stroke-width:2; stroke-dasharray:6 4; }
  .tool-connections__results { position:relative; }
  ul { display:grid; padding:0; margin:0; list-style:none; }
  li { display:flex; gap:var(--space-2); align-items:center; border-bottom:1px solid var(--color-border); padding-inline:var(--space-3); background:var(--color-bg); }
  li[data-connected="true"] { background:var(--color-accent-soft); box-shadow:inset 3px 0 var(--color-accent); }
  li a { display:flex; flex:1; align-items:center; justify-content:space-between; min-width:0; min-height:44px; gap:var(--space-2); color:var(--color-text); text-decoration:none; font-weight:650; }
  .tool-connections__match { color:var(--color-accent); font-size:var(--text-xs); }
  @media(min-width:768px) { .tool-connections__map { grid-template-columns:minmax(150px,.45fr) minmax(0,1fr); gap:80px; } .tool-connections__tools { display:grid; align-content:start; } }
  @media(max-width:767px) { .tool-connections__paths { display:none; } [data-enhanced] li[data-connected="false"] { display:none; } }
  @media(prefers-reduced-motion:no-preference) { .tool-connections__paths :global(path) { animation:tool-path 420ms ease-out; } @keyframes tool-path { from { stroke-dashoffset:60; } to { stroke-dashoffset:0; } } }
</style>

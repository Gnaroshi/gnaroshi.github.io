---
import type { Locale } from "../../i18n/types";
import { getLocalePath } from "../../i18n/utils";
import SectionNav from "../navigation/SectionNav.astro";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const entries = locale === "ko"
  ? [
      ["at-a-glance-heading", "한눈에 보기"],
      ["public-workflow", "공개 흐름"],
      ["scenario-heading", "사용 흐름"],
      ["system-workflow-title-full", "저장소 구조"],
      ["current-state", "현재 상태"],
      ["current-limitations", "현재 한계"]
    ]
  : [
      ["at-a-glance-heading", "At a glance"],
      ["public-workflow", "Public workflow"],
      ["scenario-heading", "Example workflow"],
      ["system-workflow-title-full", "Repository structure"],
      ["current-state", "Current state"],
      ["current-limitations", "Current limitations"]
    ];
---

<SectionNav class="project-section-nav" label={locale === "ko" ? "이 프로젝트의 목차" : "On this project page"} items={entries.map(([id,label]) => ({href:getLocalePath(locale, `/projects/gnaroshi-dev/#${id}`), label:label!}))} />

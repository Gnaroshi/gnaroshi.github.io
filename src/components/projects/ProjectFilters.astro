---
import { LayoutGrid, FlaskConical, BookOpen, Wrench } from "lucide-react";
import type { Locale } from "../../i18n/types";
interface Props { locale:Locale }
const {locale}=Astro.props;
const choices=locale==="ko"?[["all","전체",LayoutGrid],["experiments","실험",FlaskConical],["papers","논문과 발행",BookOpen],["tools","일상 도구",Wrench]] as const:[["all","All work",LayoutGrid],["experiments","Experiments",FlaskConical],["papers","Papers & publishing",BookOpen],["tools","Everyday tools",Wrench]] as const;
---
<div class="project-filters" hidden data-project-filters role="group" aria-label={locale==="ko"?"목적별 프로젝트":"Projects by purpose"}>
  {choices.map(([id,label,Icon])=><button type="button" data-project-filter={id} aria-pressed={id==="all"} aria-controls="selected-projects featured-applications supporting-applications"><Icon size={17} aria-hidden="true"/>{label}</button>)}
</div>
<script>
  const root=document.querySelector<HTMLElement>("[data-project-filters]");
  if(root){
    const cards=[...document.querySelectorAll<HTMLElement>("[data-project-id]")];
    const groups:Record<string,readonly string[]>={
      experiments:["gnaroshi-vla","runshelf","tr-gpu-monitor"],
      papers:["gnaroshi-dev","gnaroshi-studio","paperflow","arxiv-discovery"],
      tools:["runshelf","tr-gpu-monitor","codex-unlock-stale","contentdeck"]
    };
    const buttons=[...root.querySelectorAll<HTMLButtonElement>("[data-project-filter]")];
    const targetForHash=(hash:string)=>{
      try{return document.getElementById(decodeURIComponent(hash.replace(/^#/,"")));}
      catch{return null;}
    };
    const select=(button:HTMLButtonElement)=>{
      const key=button.dataset.projectFilter!;
      buttons.forEach(item=>item.setAttribute("aria-pressed",String(item===button)));
      for(const card of cards)card.hidden=key!=="all"&&!groups[key]!.includes(card.dataset.projectId!);
      for(const section of document.querySelectorAll<HTMLElement>(".project-section")){
        section.hidden=![...section.querySelectorAll<HTMLElement>("[data-project-id]")].some(item=>!item.hidden);
        const link=document.querySelector<HTMLAnchorElement>(`.projects-overview a[href$="#${section.id}"]`);
        if(link){link.hidden=section.hidden;const item=link.closest("li");if(item)item.hidden=section.hidden;if(section.hidden)link.removeAttribute("aria-current");}
      }
      for(const pair of document.querySelectorAll<HTMLElement>(".featured-app-pair"))pair.hidden=![...pair.querySelectorAll<HTMLElement>("[data-project-id]")].some(item=>!item.hidden);
      root.dataset.selected=key;
      window.dispatchEvent(new Event("resize"));window.dispatchEvent(new Event("scroll"));
    };
    buttons.forEach((button,index)=>{
      button.addEventListener("click",()=>select(button));
      button.addEventListener("keydown",event=>{
        const delta=event.key==="ArrowRight"?1:event.key==="ArrowLeft"?-1:0;if(!delta)return;
        event.preventDefault();const next=buttons[(index+delta+buttons.length)%buttons.length]!;next.focus({preventScroll:true});select(next);
      });
    });
    window.addEventListener("gnaroshi:reveal-anchor",event=>{
      const hash=(event as CustomEvent<{hash:string}>).detail.hash;
      const target=targetForHash(hash);
      if(target?.closest("[hidden]"))select(buttons[0]!);
    });
    window.addEventListener("hashchange",()=>{
      const target=targetForHash(location.hash);
      if(target?.closest("[hidden]")){select(buttons[0]!);target.scrollIntoView({block:"start"});}
    });
    root.hidden=false;select(buttons[0]!);
  }
</script>
<style>
  .project-filters { display:flex; flex-wrap:wrap; gap:var(--space-2); }
  .project-filters[hidden] { display:none; }
  button { display:flex; align-items:center; gap:var(--space-2); min-height:44px; padding:var(--space-2) var(--space-3); border:1px solid var(--color-border); color:var(--color-text-secondary); background:var(--color-bg); cursor:pointer; font:inherit; font-size:var(--text-sm); }
  button[aria-pressed="true"] { background:var(--color-accent-soft); color:var(--color-accent); border-color:var(--color-accent); box-shadow:inset 0 -2px var(--color-accent); }
  @media(max-width:479px) { .project-filters { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); } button { justify-content:flex-start; padding-inline:var(--space-2); font-size:var(--text-xs); } }
</style>

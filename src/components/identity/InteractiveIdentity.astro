---
import type { Locale } from "../../i18n/types";
import { translate } from "../../i18n/utils";
interface Props { locale:Locale }
const { locale } = Astro.props;
const labels = {
  original:translate(locale,"identity.original"),
  dimensional:translate(locale,"identity.dimensional"),
  foil:translate(locale,"identity.foil"),
  activate:translate(locale,"identity.activate"),
  unavailable:translate(locale,"identity.unavailable"),
  loading:translate(locale,"identity.loading")
};
---
<figure class="interactive-identity" data-interactive-identity data-labels={JSON.stringify(labels)} data-mode="original" data-clicks="0">
  <button class="interactive-identity__stage" type="button" aria-label={labels.activate} aria-describedby="identity-state" data-identity-stage disabled>
    <img class="interactive-identity__image" src="/icon-512.png" width="512" height="512" alt="Gnaroshi" draggable="false" data-identity-image />
    <span class="interactive-identity__canvas" aria-hidden="true" data-identity-canvas></span>
    <span class="interactive-identity__corners" aria-hidden="true"></span>
  </button>
  <figcaption>
    <div class="interactive-identity__caption"><span>Gnaroshi</span><span id="identity-state" role="status" aria-live="polite" data-identity-status>{labels.original}</span></div>
    <div class="interactive-identity__controls">
      <span class="interactive-identity__progress" aria-hidden="true">{Array.from({length:6},(_,index) => <i data-identity-dot={index + 1}></i>)}</span>
      <button class="identity-control" type="button" data-identity-pause title={translate(locale,"identity.pause")} aria-label={translate(locale,"identity.pause")} aria-pressed="false" hidden><span class="identity-control__pause" aria-hidden="true"></span></button>
      <button class="identity-control" type="button" data-identity-reset title={translate(locale,"identity.reset")} aria-label={translate(locale,"identity.reset")} disabled><span aria-hidden="true">↺</span></button>
    </div>
  </figcaption>
</figure>
<script>
  import { mountInteractiveIdentity } from "../../utils/interactiveIdentity";
  for (const element of document.querySelectorAll<HTMLElement>("[data-interactive-identity]")) mountInteractiveIdentity(element);
</script>
<style>
  .interactive-identity { display:grid; gap:var(--space-3); width:100%; max-width:360px; margin:0; justify-self:center; }
  .interactive-identity__stage { position:relative; display:grid; width:100%; aspect-ratio:1.1; padding:0; border:0; border-radius:0; background:none; overflow:visible; place-items:center; cursor:pointer; touch-action:pan-y; }
  .interactive-identity__image { display:block; width:86%; height:86%; object-fit:contain; border-radius:0; }
  .interactive-identity__canvas { position:absolute; inset:0; visibility:hidden; pointer-events:none; }
  .interactive-identity__canvas :global(canvas) { display:block; width:100%; height:100%; }
  [data-renderer="webgl"] .interactive-identity__image { visibility:hidden; }
  [data-renderer="webgl"] .interactive-identity__canvas { visibility:visible; }
  .interactive-identity__corners { position:absolute; inset:8%; pointer-events:none; border:1px solid transparent; transition:inset 250ms,border-color 250ms; }
  .interactive-identity__stage:where(:hover,:focus-visible) .interactive-identity__corners { inset:3%; border-color:var(--color-identity-teal); }
  .interactive-identity__corners::before,.interactive-identity__corners::after { position:absolute; width:12px; height:12px; border:2px solid var(--color-identity-orange); content:""; }
  .interactive-identity__corners::before { top:-1px; left:-1px; border-bottom:0; border-right:0; }
  .interactive-identity__corners::after { bottom:-1px; right:-1px; border-top:0; border-left:0; }
  figcaption { display:flex; justify-content:space-between; gap:var(--space-3); align-items:center; min-height:44px; color:var(--color-text-secondary); font-size:var(--text-xs); }
  .interactive-identity__caption { display:grid; gap:var(--space-1); }
  .interactive-identity__caption [data-identity-status] { min-height:2.8em; line-height:1.4; overflow-wrap:anywhere; }
  .interactive-identity__caption > span:first-child { color:var(--color-text); font-family:var(--font-mono); font-weight:750; }
  .interactive-identity__controls { display:grid; grid-template-columns:20px 44px 44px; align-items:center; gap:var(--space-2); }
  [data-identity-pause] { grid-column:2; }
  [data-identity-reset] { grid-column:3; }
  .interactive-identity__progress { display:grid; grid-template-columns:repeat(3,5px); gap:4px; }
  .interactive-identity__progress i { display:block; width:5px; height:5px; background:var(--color-border-strong); }
  .interactive-identity__progress i[data-active] { background:var(--color-accent); }
  .identity-control { display:grid; width:44px; height:44px; place-items:center; border:0; border-bottom:1px solid var(--color-border); background:none; color:var(--color-text-secondary); cursor:pointer; font-size:24px; }
  .identity-control:disabled { opacity:.35; cursor:default; }
  .interactive-identity__stage:disabled { cursor:default; }
  .identity-control[hidden] { display:none; }
  .identity-control:where(:hover,:focus-visible):not(:disabled) { color:var(--color-accent); background:var(--color-accent-soft); }
  .identity-control__pause { width:12px; height:15px; border-inline:4px solid currentColor; }
  [aria-pressed="true"] .identity-control__pause { width:0; height:0; border:7px solid transparent; border-inline-start:11px solid currentColor; margin-inline-start:7px; }
  [data-mode="foil"] .interactive-identity__corners { border-color:var(--color-identity-teal); }
  [data-renderer="fallback"][data-mode="foil"] .interactive-identity__image { filter:saturate(1.4) contrast(1.08); }
  @media (max-width:767px) { .interactive-identity { max-width:280px; } }
  @media (prefers-reduced-motion:reduce) { .interactive-identity__corners { transition:none; } }
</style>

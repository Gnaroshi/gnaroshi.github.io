---
import { Layers3, Pause, Play, RotateCcw } from "lucide-react";
import type { Locale } from "../../i18n/types";
interface Props { variant: "fold" | "terrain" | "assembly" | "identity"; locale: Locale }
const { variant, locale } = Astro.props;
const labels = locale === "ko" ? {
  name:"입체 일러스트", pause:"움직임 정지", play:"움직임 재개", reset:"처음 모습으로", unfold:"구조 펼치기",
  help:"드래그하거나 방향키로 시점을 바꿉니다. Enter 또는 Space로 구조를 펼칩니다. Escape로 초기화합니다. 연구 데이터가 아닌 입체 일러스트입니다."
} : {
  name:"Spatial illustration", pause:"Pause motion", play:"Resume motion", reset:"Reset view", unfold:"Unfold structure",
  help:"Drag or use the arrow keys to change the view. Enter or Space unfolds the structure. Escape resets it. This is an illustration, not research data."
};
if(variant==="terrain")labels.unfold=locale==="ko"?"입체 지형 평평하게":"Flatten landscape";
if(variant==="assembly")labels.unfold=locale==="ko"?"구조 분리하기":"Separate layers";
if(variant==="identity")labels.help=locale==="ko"?"포인터나 방향키로 배경 시점을 바꿉니다. Escape로 초기화합니다. 연구 데이터가 아닌 일러스트입니다.":"The pointer and arrow keys change the background view. Escape resets it. This is an illustration, not research data.";
const id=`spatial-${variant}`;
---
<div class="spatial-scene" data-spatial-scene data-variant={variant} data-scene-labels={JSON.stringify(labels)} aria-hidden="true">
  <div class="spatial-scene__canvas" data-scene-canvas tabindex="-1" role="group" aria-label={labels.name} aria-describedby={`${id}-help`}></div>
  <p class="sr-only" id={`${id}-help`}>{labels.help}</p>
  <div class="spatial-scene__controls" hidden data-scene-controls>
    {variant!=="identity"&&<button type="button" data-scene-unfold aria-label={labels.unfold} title={labels.unfold} aria-pressed="false"><Layers3 size={18} aria-hidden="true" /></button>}
    <button type="button" data-scene-pause aria-label={labels.pause} title={labels.pause}><span data-pause-icon><Pause size={18} aria-hidden="true" /></span><span data-play-icon hidden><Play size={18} aria-hidden="true" /></span></button>
    <button type="button" data-scene-reset aria-label={labels.reset} title={labels.reset}><RotateCcw size={18} aria-hidden="true" /></button>
  </div>
</div>
<script>
  import { mountSpatialScene } from "../../utils/spatialSceneController";
  for (const root of document.querySelectorAll<HTMLElement>("[data-spatial-scene]")) mountSpatialScene(root);
</script>
<style>
  .spatial-scene { position:absolute; inset:0; min-width:0; overflow:hidden; }
  .spatial-scene__canvas { position:absolute; inset:0; touch-action:pan-y pinch-zoom; cursor:grab; }
  .spatial-scene__canvas:active { cursor:grabbing; }
  .spatial-scene__canvas :global(canvas) { display:block; width:100%; height:100%; }
  .spatial-scene__controls { position:absolute; bottom:16px; right:16px; display:flex; gap:8px; z-index:3; }
  .spatial-scene__controls[hidden], .spatial-scene__controls :global([hidden]) { display:none; }
  .spatial-scene__controls button { display:grid; place-items:center; width:44px; height:44px; border:1px solid var(--color-border-strong); background:var(--color-bg); color:var(--color-text); cursor:pointer; }
  .spatial-scene__controls button[aria-pressed="true"] { color:var(--color-accent); border-color:var(--color-accent); }
  .spatial-scene__canvas:focus-visible { outline:2px solid var(--color-focus); outline-offset:-4px; }
</style>

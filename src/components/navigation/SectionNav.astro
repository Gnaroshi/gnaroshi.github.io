---
interface Props {
  label: string;
  items: readonly { href: string; label: string }[];
  class?: string;
}
const { label, items, class: className } = Astro.props;
---
<nav class:list={["section-nav", className]} aria-label={label} data-in-page-navigation data-scroll-spy>
  <ol data-in-page-scroller>
    {items.map((item) => <li><a href={item.href} data-in-page-link>{item.label}</a></li>)}
  </ol>
</nav>

<style>
  .section-nav { position:sticky; z-index:12; top:var(--header-height); min-width:0; padding-block:var(--space-2); background:var(--color-bg); }
  ol { display:flex; min-width:0; gap:var(--space-2); padding:0; margin:0; overflow-x:auto; list-style:none; scrollbar-color:var(--color-border-strong) transparent; scrollbar-width:thin; }
  li { display:flex; flex:0 0 auto; }
  a { position:relative; display:flex; min-height:44px; align-items:center; padding:var(--space-2) var(--space-3); color:var(--color-text-secondary); font-size:var(--text-sm); font-weight:700; line-height:1.4; text-decoration:none; white-space:nowrap; }
  a::after { position:absolute; inset-inline:var(--space-3); bottom:0; height:2px; background:var(--color-accent); opacity:0; transform:scaleX(0); transform-origin:left; content:""; transition:transform var(--duration-state) var(--ease-emphasized),opacity var(--duration-fast); }
  a:hover { background:var(--color-surface-muted); color:var(--color-text); }
  a[aria-current="location"] { background:var(--color-accent-soft); color:var(--color-accent); }
  a[aria-current="location"]::after { opacity:1; transform:scaleX(1); }
  @media (prefers-reduced-motion:reduce) { a,a::after { transition:none; } }
</style>

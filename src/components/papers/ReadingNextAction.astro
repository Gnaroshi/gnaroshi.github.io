---
import type { Locale } from "../../i18n/types";
import { getLocalePath, translate } from "../../i18n/utils";
import { getPublishedPapers } from "../../utils/papers";
interface Props { locale: Locale }
const { locale } = Astro.props;
const hasPapers = (await getPublishedPapers(locale)).length > 0;
---
<a class="button button--primary" href={getLocalePath(locale, hasPapers ? "/papers/" : "/research/#human-ai-research-tools")}>{translate(locale, hasPapers ? "nav.paperLab" : "nav.research")}</a>

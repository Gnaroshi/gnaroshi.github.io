---
import RedirectPage from "../../../components/RedirectPage.astro";
import { getBuildablePapers, type PaperEntry } from "../../../utils/papers";

export async function getStaticPaths() {
  return (await getBuildablePapers()).map((paper) => ({ params: { slug: paper.data.canonicalSlug }, props: { paper } }));
}

interface Props { paper: PaperEntry }
const { paper } = Astro.props as Props;
const slug = paper.data.canonicalSlug;
---
<RedirectPage target={`/papers/${slug}/`} />
